# Sanity
PUBLIC_SANITY_PROJECT_ID=PROJECT_ID
PUBLIC_SANITY_DATASET=production
# Viewer token from sanity.io/manage -> API -> Tokens.
# Required for draft preview / visual editing; 500s on /api/draft-mode/enable without it.
# SANITY_API_READ_TOKEN=

# Origin the Presentation Tool previews. Dev port; production overrides (e.g. https://yourdomain.com)
PUBLIC_SITE_URL=http://localhost:4324