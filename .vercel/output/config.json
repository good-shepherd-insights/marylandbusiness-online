{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/directory\\.json$",
			"dest": "_render"
		},
		{
			"src": "^/api/draft-mode/disable/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/draft-mode/enable/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/directory-audit\\.json$",
			"dest": "_render"
		},
		{
			"src": "^/og/blog/(.*?)\\.png$",
			"dest": "_render"
		},
		{
			"src": "^/og/(.*?)\\.png$",
			"dest": "_render"
		},
		{
			"src": "^/resources/?$",
			"dest": "_render"
		},
		{
			"src": "^/sitemap\\.xml$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/([^/]+?)/([^/]+?)/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/([^/]+?)/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}