---
import "@fontsource-variable/gabarito";
import themeConfig from "@util/themeConfig";
import { getSiteSettings } from "@lib/sanity/queries";
import "../styles/global.css";
import Posthog from "@components/analytics/Posthog.astro";
import SanityVisualEditing from "@components/SanityVisualEditing";
import DisableDraftMode from "@components/DisableDraftMode";
import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';

const draftMode = Astro.cookies.has(perspectiveCookieName);
const settings = await getSiteSettings(Astro.cookies.get(perspectiveCookieName)?.value);
import { ClientRouter } from "astro:transitions";
import { getOGImage } from "@util/getOGImage";

const { title, slug } = Astro.props;
const siteTitle = settings?.siteTitle ?? themeConfig.general.title;
const seoName = settings?.seoName ?? themeConfig.general.seo?.name;
const seoDescription = settings?.seoDescription ?? themeConfig.general.seo?.description;
const seoUrl = settings?.seoUrl ?? themeConfig.general.seo?.url;
let seoDomain: string | undefined;
try {
  seoDomain = seoUrl ? new URL(seoUrl).hostname : undefined;
} catch {
  seoDomain = undefined;
}

const calculatedTitle = title || siteTitle;
// Home (and any layout without a slug) shares the index OG image.
const ogSlug = slug ?? 'index';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{calculatedTitle}</title>
    <meta name="description" content={seoDescription} />

    <!-- Facebook Meta Tags -->
    <meta property="og:url" content={seoUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={calculatedTitle} />
    <meta
      property="og:description"
      content={seoDescription}
    />
    <meta property="og:image" content={getOGImage(ogSlug, settings?.seoUrl)} />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    {seoDomain && <meta property="twitter:domain" content={seoDomain} />}
    <meta property="twitter:url" content={seoUrl} />
    <meta name="twitter:title" content={seoName} />
    <meta
      name="twitter:description"
      content={seoDescription}
    />
    <meta name="twitter:image" content={getOGImage(ogSlug, settings?.seoUrl)} />
    <ClientRouter />
  </head>
  <body class="bg-white dark:bg-gray-900">
    <slot />
    <Posthog />
    {draftMode && (
      <>
        <SanityVisualEditing client:only="react" />
        <DisableDraftMode client:only="react" />
      </>
    )}
  </body>
</html>
