---
/**
 * Global footer (census 14, design 9CGLhn7IuWzEhRoEnKtp): brand block +
 * Quick Links / Resources columns + legal bar. All copy from siteSettings;
 * no icons in the design. Links without href render as non-link text (no
 * dead "#" anchors). Copyright year renders dynamically.
 */
import type { SanitySiteSettings } from '@lib/sanity/types';

interface Props {
  settings: SanitySiteSettings;
}

const { settings } = Astro.props;
const year = new Date().getFullYear();
---

{
  settings.footerBrandName && (
    <footer id="footer" class="site-footer bg-[#FAF7F2] py-16 md:py-24 px-4 md:px-12 border-t border-[var(--border)]">
      <div class="max-w-7xl mx-auto grid md:grid-cols-4 gap-12 md:gap-16">
        <div class="col-span-1 md:col-span-2">
          <div class="flex items-center gap-3 mb-8">
            {settings.footerBrandBadge && (
              <div class="w-10 h-10 bg-[var(--primary)] flex items-center justify-center text-white font-extrabold text-xl shrink-0">
                {settings.footerBrandBadge}
              </div>
            )}
            <span class="font-extrabold text-2xl text-[var(--card-foreground)] tracking-tight uppercase">
              {settings.footerBrandName}
            </span>
          </div>
          {settings.footerTagline && (
            <p class="text-xs text-[var(--foreground)] max-w-md mb-6 md:mb-10 leading-relaxed font-bold uppercase tracking-widest">
              {settings.footerTagline}
            </p>
          )}
        </div>

        {settings.footerQuickHeading && (
          <div>
            <h4 class="font-bold text-[var(--card-foreground)] mb-8 text-[10px] uppercase tracking-[0.2em]">
              {settings.footerQuickHeading}
            </h4>
            <ul class="flex flex-col gap-4 text-[11px] font-bold uppercase tracking-widest">
              {(settings.footerQuickLinks ?? []).map((link) => (
                <li>
                  {link.href ? (
                    <a href={link.href} class="text-[var(--foreground)] hover:text-[var(--primary)] transition-colors">
                      {link.label}
                    </a>
                  ) : (
                    <span class="text-[var(--foreground)]">{link.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}

        {settings.footerResourceHeading && (
          <div>
            <h4 class="font-bold text-[var(--card-foreground)] mb-8 text-[10px] uppercase tracking-[0.2em]">
              {settings.footerResourceHeading}
            </h4>
            <ul class="flex flex-col gap-4 text-[11px] font-bold uppercase tracking-widest">
              {(settings.footerResourceLinks ?? []).map((link) => (
                <li>
                  {link.href ? (
                    <a href={link.href} class="text-[var(--foreground)] hover:text-[var(--primary)] transition-colors">
                      {link.label}
                    </a>
                  ) : (
                    <span class="text-[var(--foreground)]">{link.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <div class="max-w-7xl mx-auto mt-16 md:mt-24 pt-10 border-t border-[var(--border)] flex flex-col md:flex-row justify-between items-center gap-6 text-[9px] font-bold text-[var(--muted-foreground)] uppercase tracking-[0.3em]">
        <p>
          &copy; {year}
          {settings.footerLegalName ? ` ${settings.footerLegalName}.` : ''}
        </p>
        <div class="flex gap-8">
          {(settings.footerLegalLinks ?? []).map((link) =>
            link.href ? (
              <a href={link.href} class="hover:text-[var(--primary)] transition-colors">
                {link.label}
              </a>
            ) : (
              <span>{link.label}</span>
            )
          )}
        </div>
      </div>
    </footer>
  )
}

<style>
  .site-footer {
    --foreground: #555555;
    --card-foreground: #121212;
    --primary: #9d2235;
    --muted-foreground: #7a7a7a;
    --border: #e3e0dc;
    font-family: 'Sora Variable', 'Sora', sans-serif;
  }
</style>
