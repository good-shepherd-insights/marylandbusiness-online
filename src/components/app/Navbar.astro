---
/**
 * Global navbar (design: site nav across the MD designs — logo slot left,
 * bold uppercase micro links, primary CTA right). Replaces the trust bar
 * slot on home. Left slot stays EMPTY — reserved for the vector logo.
 * Link labels/hrefs + CTA label from siteSettings; icons are code
 * literals; hovers dropped (V-10).
 */
import { Icon } from 'astro-icon/components';
import type { SanitySiteSettings } from '@lib/sanity/types';

interface Props {
  settings: SanitySiteSettings;
}

const { settings } = Astro.props;
const links = settings.navLinks ?? [];---

{links.length > 0 && (
  <nav class="site-navbar sticky top-0 z-50 bg-white border-b border-[var(--border)] h-16 md:h-[72px] flex items-center px-4 md:px-12 justify-between">
    <!-- Reserved: vector logo goes here -->
    <div class="w-10 h-10 shrink-0" aria-hidden="true"></div>

    <div class="hidden lg:flex items-center gap-10 font-bold text-[11px] uppercase tracking-widest text-[var(--foreground)]">
      {links.map((link) => (
        link.label && <a href={link.href ?? '#'}>{link.label}</a>
      ))}
    </div>

    <div class="flex items-center gap-4">
      {settings.navCtaLabel && (
        <a href="#" class="btn-primary px-3 py-2 text-[11px] md:px-6 md:py-4 md:text-xs">{settings.navCtaLabel}</a>
      )}
      <button type="button" class="mobile-toggle lg:hidden p-1" aria-label="Menu">
        <Icon name="tabler:menu" class="w-5 h-5 text-[var(--card-foreground)]" />
      </button>
    </div>

    <div class="mobile-panel hidden absolute top-full left-0 right-0 bg-white border-b border-[var(--border)] flex-col px-4 py-4">
      {links.map((link) => (
        link.label && <a href={link.href ?? '#'} class="py-3 font-bold text-[11px] uppercase tracking-widest text-[var(--foreground)]">{link.label}</a>
      ))}
    </div>
  </nav>
)}

<script>
  document.querySelectorAll<HTMLButtonElement>('.mobile-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelector('.site-navbar .mobile-panel')?.classList.toggle('hidden');
      document.querySelector('.site-navbar .mobile-panel')?.classList.toggle('flex');
    });
  });
</script>

<style>
  .site-navbar {
    --foreground: #404040;
    --card-foreground: #121212;
    --primary: #9d2235;
    --border: #e3e0dc;
    font-family: 'Sora Variable', 'Sora', sans-serif;
  }
  .mobile-panel {
    display: none;
  }
  .mobile-panel.flex {
    display: flex;
  }
  .btn-primary {
    background-color: var(--primary);
    color: #fff;
    border-radius: 4px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
