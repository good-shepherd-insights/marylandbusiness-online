---
// Sidebar navigation now reads CMS hub state (TAGS.md): only paths that
// pass the gate appear. /tags/* is retired.
import { getGeoCountyHubs, getTypeHubs } from "@lib/directory/paths";

const [counties, types] = await Promise.all([getGeoCountyHubs(), getTypeHubs()]);
---

<div
  class="hidden md:block max-w-50 w-full border-r border-gray-200 dark:border-gray-700 dark:text-gray-50"
>
  <a
    class="flex mt-2 text-sm font-medium text-gray-700 dark:text-gray-300 items-center gap-2 px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700"
    href="/"
  >
    <span>Home</span>
  </a>
  <a
    class="flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 gap-2 px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700"
    href="/"
  >
    <span>Categories</span>
  </a>
  {types.map((hub) => (
    <a
      class="flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 gap-2 px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700"
      href={`/${hub.path}`}
    >
      <span class="border border-gray-200 dark:border-gray-600 rounded h-7 w-7 inline-flex items-center justify-center" />
      <span>{hub.label}</span>
    </a>
  ))}
  <p class="px-4 pt-4 pb-1 text-xs uppercase tracking-wide text-gray-400">Counties</p>
  {counties.map((hub) => (
    <a
      class="flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 gap-2 px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700"
      href={`/${hub.path}`}
    >
      <span class="border border-gray-200 dark:border-gray-600 rounded h-7 w-7 inline-flex items-center justify-center" />
      <span>{hub.label}</span>
    </a>
  ))}
</div>