---
import config from "@util/themeConfig";
import BulletCard from "./BulletCard.astro";
import RectangleCard from "./RectangleCard.astro";
import SmallHorizontalCard from "./SmallHorizontalCard.astro";

const { item } = Astro.props;

const myItem = {
  ...item,
  ...item.data,
};

// Outbound links only when configured AND the entry actually carries a link
// field (JSON directory entries do; Sanity listings do not — they route by id).
// Detail path: geographic when the listing carries county+city
// (`/[county]/[city]/[business]`, TAGS.md); flat slug as fallback until the
// city data lands.
const geoHref =
  myItem.county?.slug?.current && myItem.city?.slug?.current
    ? `/${myItem.county.slug.current}/${myItem.city.slug.current}/${myItem.id}`
    : undefined;

const href = geoHref ?? `/${myItem.id}`;

const type = config.directoryUI.grid.type;
---

<div
  class="listing"
  transition:name={`${myItem.id}-card`}
  data-tags={[myItem.county?.slug?.current, myItem.city?.slug?.current, myItem.subcategory?.slug?.current].filter(Boolean).join(",")}
>
  {type == "icon-list" && <BulletCard myItem={myItem} href={href} />}
  {
    type == "rectangle-card-grid" && (
      <RectangleCard myItem={myItem} href={href} />
    )
  }
  {
    type == "small-card-grid" && (
      <SmallHorizontalCard myItem={myItem} href={href} />
    )
  }
</div>
