---
/**
 * Upcoming events & press — design markup: date box, title, time • venue,
 * outline CTA. All content from seeded listingEvent objects.
 */
import type { SanityListing } from '@lib/sanity/types';

interface Props {
  listing: SanityListing;
}

const { listing } = Astro.props;
const valid = (listing.events ?? []).filter((event) => event.title);
---

{
  valid.length > 0 && (
    <section id="events">
      <h2 class="text-xl font-extrabold text-[var(--card-foreground)] uppercase tracking-widest mb-8">
        {listing.eventsHeading}
      </h2>
      <div class="space-y-4">
        {valid.map((event) => (
          <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-8 p-6 border border-[var(--border)]">
            <div class="flex flex-col items-center justify-center w-16 h-16 bg-[var(--icon-box)] border border-[var(--border)] shrink-0">
              <span class="text-[10px] font-bold text-[var(--primary)] uppercase">{event.month}</span>
              <span class="text-xl font-extrabold">{event.day}</span>
            </div>
            <div class="flex-1">
              <h3 class="text-sm font-extrabold uppercase tracking-tight">{event.title}</h3>
              <p class="text-xs text-[var(--foreground)] uppercase tracking-widest mt-1">
                {[event.time, event.venue].filter(Boolean).join(' • ')}
              </p>
            </div>
            {event.ctaLabel && event.ctaLink && (
              <a class="btn-outline px-6 py-3" href={event.ctaLink}>
                {event.ctaLabel}
              </a>
            )}
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  section {
    --primary: #9d2235;
    --card-foreground: #121212;
    --foreground: #555555;
    --border: #e3e0dc;
    --icon-box: #f8f7f6;
    font-family: 'Sora Variable', 'Sora', sans-serif;
    padding: 64px 0;
    border-bottom: 1px solid var(--border);
  }
  .btn-outline {
    border: 2px solid var(--card-foreground);
    background: transparent;
    color: var(--card-foreground);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 12px;
    border-radius: 0;
    display: block;
    text-align: center;
  }
</style>
