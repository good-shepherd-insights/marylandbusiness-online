---
/**
 * Team — design markup: three centered cards, round primary-bordered
 * avatars, role in primary, bio, underlined CTA.
 */
import { sanityImageUrl } from '@lib/sanity/client';
import type { SanityListing } from '@lib/sanity/types';

interface Props {
  listing: SanityListing;
}

const { listing } = Astro.props;
const valid = (listing.team ?? []).filter((member) => member.name);
---

{
  valid.length > 0 && (
    <section id="team">
      <h2 class="text-xl font-extrabold text-[var(--card-foreground)] uppercase tracking-widest mb-8">
        {listing.teamHeading}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {valid.map((member) => (
          <div class="border border-[var(--border)] p-8 flex flex-col items-center text-center">
            <div class="w-24 h-24 rounded-full overflow-hidden border-2 border-[var(--primary)] mb-5">
              {member.avatar?.asset && (
                <img
                  src={sanityImageUrl(member.avatar, { width: 192 })}
                  alt={member.avatar.alt ?? member.name ?? ''}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              )}
            </div>
            <h3 class="text-sm font-extrabold uppercase tracking-tight mb-1">{member.name}</h3>
            <span class="text-[10px] font-bold text-[var(--primary)] uppercase tracking-widest mb-4">
              {member.role}
            </span>
            <p class="text-xs text-[var(--foreground)] leading-relaxed mb-5">{member.bio}</p>
            {member.ctaLabel && member.ctaLink && (
              <a
                class="text-[10px] font-extrabold uppercase tracking-widest text-[var(--card-foreground)] border-b-2 border-[var(--card-foreground)] pb-1"
                href={member.ctaLink}
              >
                {member.ctaLabel}
              </a>
            )}
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  section {
    --primary: #9d2235;
    --card-foreground: #121212;
    --foreground: #555555;
    --border: #e3e0dc;
    font-family: 'Sora Variable', 'Sora', sans-serif;
    padding: 64px 0;
    border-bottom: 1px solid var(--border);
  }
</style>
