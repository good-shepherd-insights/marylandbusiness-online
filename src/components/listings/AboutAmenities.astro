---
/**
 * About Us + Amenities — design markup: heading with primary left border,
 * 2/3 prose + 1/3 amenity list. Portable Text holds any paragraph count.
 */
import { PortableText } from 'astro-portabletext';
import type { SanityListing } from '@lib/sanity/types';

interface Props {
  listing: SanityListing;
}

const { listing } = Astro.props;
const hasAbout = Array.isArray(listing.about) && listing.about.length > 0;
const amenities = (listing.amenities ?? []).filter((a) => a.label);
---

{
  (hasAbout || amenities.length > 0) && (
    <section id="about">
      {listing.aboutHeading && (
        <h2 class="text-xl font-extrabold text-[var(--card-foreground)] uppercase tracking-widest mb-6 border-l-4 border-[var(--primary)] pl-6">
          {listing.aboutHeading}
        </h2>
      )}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        {hasAbout && (
          <div class="md:col-span-2 prose-content space-y-5">
            <PortableText value={listing.about ?? []} />
          </div>
        )}
        {amenities.length > 0 && (
          <div>
            <h4 class="text-[10px] font-extrabold uppercase tracking-widest text-[var(--foreground)] mb-3">
              {listing.amenitiesHeading}
            </h4>
            <ul class="grid grid-cols-1 gap-2 text-xs font-bold text-[var(--card-foreground)] uppercase tracking-tight">
              {amenities.map((amenity) => (
                <li class="flex items-center gap-2">
                  
                  {amenity.label}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  section {
    --primary: #9d2235;
    --card-foreground: #121212;
    --foreground: #555555;
    --border: #e3e0dc;
    font-family: 'Sora Variable', 'Sora', sans-serif;
    padding: 64px 0;
    border-bottom: 1px solid var(--border);
  }
</style>
