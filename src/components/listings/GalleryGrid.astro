---
/**
 * Photo gallery — design mosaic: 4 columns / 2 rows, first image spans
 * 2x2, second spans 2 columns. Positional classes only.
 */
import { sanityImageUrl } from '@lib/sanity/client';
import type { SanityImage } from '@lib/sanity/types';

interface Props {
  images: SanityImage[] | null;
}

const valid = (Astro.props.images ?? []).filter((img) => img.asset);
---

{
  valid.length > 0 && (
    <div class="grid grid-cols-2 md:grid-cols-4 md:grid-rows-2 gap-2 md:h-[500px] mb-12">
      {valid.map((img, i) => (
        <div class={`photo-grid-item ${i === 0 ? 'col-span-2 row-span-2' : i === 1 ? 'col-span-2' : ''}`}>
          <img
            src={sanityImageUrl(img, { width: i === 0 ? 1200 : 600 })}
            alt={img.alt ?? ''}
            loading={i < 2 ? 'eager' : 'lazy'}
          />
        </div>
      ))}
    </div>
  )
}

<style>
  div {
    --border: #e3e0dc;
    font-family: 'Sora Variable', 'Sora', sans-serif;
  }
  .photo-grid-item {
    overflow: hidden;
    background: #eee;
    border: 1px solid var(--border);
  }
  .photo-grid-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
