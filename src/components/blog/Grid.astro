---
import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';
const perspectiveCookie = Astro.cookies.get(perspectiveCookieName)?.value;
import PureGrid from "../directory/PureGrid.astro";
import { getBlogPosts } from "../../lib/sanity/queries";

const allPosts = await getBlogPosts(perspectiveCookie);
const blogListings = allPosts.map((value) => ({
  ...value,
  id: `blog/${value.id}`,
}));
---

<PureGrid id="directory-grid" listings={blogListings} />