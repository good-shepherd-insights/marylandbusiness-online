---
/**
 * Featured businesses section — eyebrow/heading/description header with
 * carousel arrows (presentation only) above a borderless-gap grid of
 * business cards. All content comes from Sanity `home.featuredBusinesses`;
 * the component renders nothing when the section is absent or empty and
 * never substitutes its own copy. Badge tones are presentation (CSS), not
 * CMS data.
 */
import { Icon } from 'astro-icon/components';
import { sanityImageUrl } from '@lib/sanity/client';
import type { FeaturedBusinessesContent, FeaturedBusiness } from '@lib/sanity/types';

interface Props {
  featuredBusinesses: FeaturedBusinessesContent;
}

const { eyebrow, heading, description, businesses } = Astro.props.featuredBusinesses;

const validBusinesses = (businesses ?? []).filter((b) => b.title);
---

{
  validBusinesses.length > 0 && (
    <section class="featured">
      <div class="featured-inner">
        <div class="featured-header">
          <div class="featured-intro">
            {heading && <h2>{heading}</h2>}
            {description && <p>{description}</p>}
          </div>
          <div class="featured-arrows">
            <button type="button" class="featured-arrow" data-carousel-prev aria-label="Previous">
              <Icon name="tabler:chevron-left" />
            </button>
            <button type="button" class="featured-arrow" data-carousel-next aria-label="Next">
              <Icon name="tabler:chevron-right" />
            </button>
          </div>
        </div>
        <div class="featured-grid" data-cards>
          {validBusinesses.map((b: FeaturedBusiness) => (
            <article class="featured-card">
              <div class="featured-media">
                {b.image?.asset && (
                  <img
                    src={sanityImageUrl(b.image, { width: 800 })}
                    srcset={`${sanityImageUrl(b.image, { width: 400 })} 1x, ${sanityImageUrl(b.image, { width: 800 })} 2x`}
                    alt={b.imageAlt ?? ''}
                    loading="lazy"
                  />
                )}
                {b.badgeLabel && (
                  <div class="featured-badge" data-tone={b.badgeTone === 'dark' ? 'dark' : 'verified'}>
                    <Icon name={b.badgeTone === 'dark' ? 'tabler:medal' : 'tabler:circle-check'} />
                    <span>{b.badgeLabel}</span>
                  </div>
                )}
                {b.category && <span class="featured-category">{b.category}</span>}
              </div>
              <div class="featured-body">
                {b.title && <h3>{b.title}</h3>}
                <div class="featured-rating">
                  <div class="featured-stars" aria-hidden="true">
                    {Array.from({ length: 5 }).map(() => <Icon name="tabler:star-filled" />)}
                  </div>
                  {b.ratingStat && <span class="featured-stat">{b.ratingStat}</span>}
                </div>
                {b.description && <p>{b.description}</p>}
                <div class="featured-actions">
                  {b.ctaLabel && b.ctaLink && (
                    <a class="featured-cta" href={b.ctaLink}>{b.ctaLabel}</a>
                  )}
                  {b.ctaIcon && (
                    <a class="featured-secondary" href={b.ctaLink} aria-label={b.ctaLabel ?? 'Contact'}>
                      <Icon name={b.ctaIcon} />
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .featured {
    --featured-primary: #9d2235;
    --featured-secondary: #855b00;
    --featured-secondary-foreground: #ffffff;
    --featured-foreground: #121212;
    --featured-muted: #404040;
    --featured-border: #e3e0dc;
    --featured-background: #fdfcfb;
    --featured-card: #faf7f2;

    background: var(--featured-background);
    padding: 6rem 1rem;
  }

  .featured-inner {
    max-width: 80rem;
    margin: 0 auto;
  }

  .featured-header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .featured-intro {
    max-width: 42rem;
  }

  .featured-eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--featured-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .featured-intro h2 {
    font-size: 2.25rem;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--featured-foreground);
    margin: 0 0 1.5rem;
  }

  .featured-intro p {
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 500;
    color: var(--featured-muted);
    margin: 0;
    max-width: 70ch;
  }

  .featured-arrows {
    display: flex;
    gap: 1rem;
  }

  .featured-arrow {
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid var(--featured-border);
    border-radius: 9999px;
    background: #ffffff;
    color: var(--featured-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .featured-arrow :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--featured-border);
    border-left: 1px solid var(--featured-border);
  }

  .featured-card {
    display: flex;
    flex-direction: column;
    background: var(--featured-card);
    border-right: 1px solid var(--featured-border);
    border-bottom: 1px solid var(--featured-border);
  }

  .featured-media {
    position: relative;
    height: 15rem;
    overflow: hidden;
  }

  .featured-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .featured-badge[data-tone='verified'] {
    background: var(--featured-secondary);
    color: var(--featured-secondary-foreground);
  }

  .featured-badge[data-tone='verified'] :global(svg) {
    color: #ffffff;
  }

  .featured-badge[data-tone='dark'] {
    background: #121212;
    color: #ffffff;
  }

  .featured-badge[data-tone='dark'] :global(svg) {
    color: var(--featured-secondary);
  }

  .featured-badge :global(svg) {
    width: 0.75rem;
    height: 0.5625rem;
  }

  .featured-category {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: #ffffff;
    color: var(--featured-foreground);
    padding: 0.25rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border: 1px solid var(--featured-border);
  }

  .featured-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 2rem;
  }

  .featured-body h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--featured-foreground);
    letter-spacing: -0.025em;
    margin: 0 0 0.5rem;
  }

  .featured-rating {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .featured-stars {
    display: flex;
    gap: 0.125rem;
  }

  .featured-stars :global(svg) {
    width: 0.75rem;
    height: 0.75rem;
    color: #ffb612;
  }

  .featured-stat {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--featured-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .featured-body p {
    font-size: 0.8125rem;
    line-height: 1.625;
    color: var(--featured-muted);
    margin: 0 0 2.5rem;
    max-width: 70ch;
  }

  .featured-actions {
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--featured-border);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .featured-cta {
    flex: 1;
    padding: 1rem;
    background: var(--featured-primary);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
    text-decoration: none;
  }

  .featured-secondary {
    width: 3.5rem;
    height: 3.5rem;
    border: 1px solid var(--featured-border);
    color: var(--featured-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .featured-secondary :global(svg) {
    width: 0.75rem;
    height: 0.75rem;
  }

  @media (min-width: 768px) {
    .featured {
      padding: 6rem 3rem;
    }

    .featured-header {
      flex-direction: row;
      align-items: flex-start;
    }

    .featured-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
