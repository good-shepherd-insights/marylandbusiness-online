---
/**
 * Featured businesses section — authentic editorial showcase of Maryland
 * businesses. Restrained interaction, rich media, structured metadata,
 * no multi-element hover choreography.
 */
import { Icon } from 'astro-icon/components';
import { sanityImageUrl } from '@lib/sanity/client';
import type { FeaturedBusinessesContent, FeaturedBusiness } from '@lib/sanity/types';

interface Props {
  featuredBusinesses: FeaturedBusinessesContent;
}

const { heading, description, businesses } = Astro.props.featuredBusinesses;
const validBusinesses = (businesses ?? []).filter((b) => b?.title);
---

{
  validBusinesses.length > 0 && (
    <section class="featured" aria-label={heading ?? 'Featured Maryland Businesses'}>
      <div class="featured-inner">
        <!-- Section Header -->
        <div class="featured-header">
          {heading && <h2>{heading}</h2>}
          {description && <p class="featured-lead">{description}</p>}
        </div>

        <!-- Editorial 3-Column Grid -->
        <div class="featured-grid">
          {validBusinesses.map((b: FeaturedBusiness) => (
            <article class="featured-item">
              <div class="featured-media">
                {b.image?.asset && (
                  <img
                    src={sanityImageUrl(b.image, { width: 720, quality: 68 })}
                    srcset={`${sanityImageUrl(b.image, { width: 360, quality: 68 })} 1x, ${sanityImageUrl(b.image, { width: 720, quality: 68 })} 2x`}
                    alt={b.imageAlt ?? b.title ?? ''}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>

              <div class="featured-body">
                <div class="featured-meta">
                  {b.category && <span class="featured-category">{b.category}</span>}
                  {b.badgeLabel && (
                    <span class="featured-verified">
                      <Icon name="tabler:circle-check-filled" aria-hidden="true" />
                      {b.badgeLabel}
                    </span>
                  )}
                </div>

                {b.title && (
                  b.ctaLink ? (
                    <h3 class="featured-title">
                      <a href={b.ctaLink} class="featured-title-link">{b.title}</a>
                    </h3>
                  ) : (
                    <h3 class="featured-title">{b.title}</h3>
                  )
                )}

                <div class="featured-rating">
                  <div class="featured-stars" role="img" aria-label="5 out of 5 stars">
                    {Array.from({ length: 5 }).map(() => (
                      <Icon name="tabler:star-filled" class="star-icon" aria-hidden="true" />
                    ))}
                  </div>
                  {b.ratingStat && <span class="featured-stat">{b.ratingStat}</span>}
                </div>

                {b.description && <p class="featured-desc">{b.description}</p>}

                <div class="featured-action-row">
                  {b.ctaLabel && b.ctaLink && (
                    <a class="featured-link" href={b.ctaLink}>
                      <span>{b.ctaLabel}</span>
                      <Icon name="tabler:arrow-right" aria-hidden="true" />
                    </a>
                  )}
                  {b.ctaIcon && (
                    <a
                      class="featured-contact"
                      href={b.ctaLink ?? '/'}
                      aria-label={b.ctaLabel ? `${b.ctaLabel} for ${b.title}` : `Contact ${b.title}`}
                    >
                      <Icon name="tabler:arrow-up-right" aria-hidden="true" />
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .featured {
    --featured-primary: #9d2235;
    --featured-secondary: #855b00;
    --featured-foreground: #121212;
    --featured-muted: #555555;
    --featured-border: #e3e0dc;
    --featured-background: #faf7f2;
    --featured-surface: #ffffff;

    background: var(--featured-background);
    padding: 5rem 1.5rem;
    font-family: 'Sora Variable', 'Sora', sans-serif;
  }

  .featured-inner {
    max-width: 80rem;
    margin: 0 auto;
  }

  /* Section Header */
  .featured-header {
    max-width: 46rem;
    margin-bottom: 2.75rem;
  }

  .featured-header h2 {
    font-size: clamp(2.25rem, 4vw, 3rem);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--featured-foreground);
    margin: 0 0 1rem;
  }

  .featured-lead {
    font-size: 1.125rem;
    line-height: 1.7;
    font-weight: 400;
    color: var(--featured-muted);
    margin: 0;
    max-width: 65ch;
  }

  /* 3-Column Editorial Grid */
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .featured-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  /* Article Item */
  .featured-item {
    display: flex;
    flex-direction: column;
    background: var(--featured-surface);
    border: 1px solid var(--featured-border);
    border-radius: 4px;
    overflow: hidden;
  }


  /* Photographic Header */
  .featured-media {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: #f0ece4;
    overflow: hidden;
  }

  .featured-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Article Body */
  .featured-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem;
  }

  /* Meta Row */
  .featured-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .featured-category {
    font-size: 0.75rem;   /* 12px */
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--featured-muted);
  }

  .featured-verified {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;   /* 12px */
    font-weight: 700;
    color: var(--featured-secondary);
  }

  .featured-verified :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  /* Typography & Editorial Hover */
  .featured-title {
    font-size: 1.25rem;  /* 20px */
    font-weight: 800;
    color: var(--featured-foreground);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }

  .featured-title-link {
    color: inherit;
    text-decoration: none;
  }

  .featured-item:hover .featured-title,
  .featured-item:hover .featured-title-link,
  .featured-title-link:hover {
    color: var(--featured-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
  }

  .featured-rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.875rem;
  }

  .featured-stars {
    display: flex;
    gap: 0.125rem;
    color: #eaaa00;
  }

  .star-icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  .featured-stat {
    font-size: 0.75rem;   /* 12px */
    font-weight: 600;
    color: var(--featured-muted);
  }

  .featured-desc {
    font-size: 0.875rem;  /* 14px */
    line-height: 1.6;
    color: var(--featured-muted);
    margin: 0 0 1.5rem;
    max-width: 65ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Action Row */
  .featured-action-row {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--featured-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .featured-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem; /* 13px */
    font-weight: 700;
    color: var(--featured-primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    min-height: 38px;
  }

  .featured-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .featured-link :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  .featured-link:focus-visible {
    outline: 2px solid var(--featured-primary);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .featured-contact {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.375rem;
    height: 2.375rem;
    border: 1px solid var(--featured-border);
    border-radius: 4px;
    color: var(--featured-foreground);
    text-decoration: none;
  }

  .featured-contact:hover {
    border-color: var(--featured-primary);
    color: var(--featured-primary);
  }

  .featured-contact:focus-visible {
    outline: 2px solid var(--featured-primary);
    outline-offset: 2px;
  }

  .featured-contact :global(svg) {
    width: 0.9375rem;
    height: 0.9375rem;
  }

  @media (min-width: 1024px) {
    .featured {
      padding: 5.5rem 2rem;
    }
  }
</style>
