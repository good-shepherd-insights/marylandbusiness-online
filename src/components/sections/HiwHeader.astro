---
/**
 * How-It-Works page header (design 12 §1): breadcrumb, route badge, h1,
 * intro, dual CTA, proof line. Icons are code literals; hovers dropped
 * (V-10). Crumb tail = the page's own title.
 */
import { Icon } from 'astro-icon/components';
import type { SanityHiwHeader } from '@lib/sanity/types';

interface Props {
  header: SanityHiwHeader;
  crumbTail?: string;
}

const { header, crumbTail } = Astro.props;
---

{
  header.heading && (
    <header class="hiw-header px-4 md:px-12 py-16 md:py-24 border-b border-[var(--border)] bg-[#FDFCFB]">
      <div class="max-w-5xl mx-auto">
        <nav class="flex items-center gap-2 mb-8 text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--foreground)]">
          {header.breadcrumbRoot && <a href="/">{header.breadcrumbRoot}</a>}
          <Icon name="tabler:chevron-right" class="w-2 h-2 opacity-40" />
          <span class="text-[var(--primary)]">{crumbTail ?? header.heading}</span>
        </nav>
        {header.badge && (
          <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-[var(--secondary)] text-[var(--secondary-foreground)] text-[11px] font-bold tracking-[0.2em] uppercase mb-8">
            <Icon name="tabler:route" class="w-3 h-3" />
            {header.badge}
          </span>
        )}
        <h1 class="text-4xl md:text-6xl font-extrabold text-[var(--card-foreground)] mb-8 leading-[1.15] tracking-tight max-w-3xl">{header.heading}</h1>
        {header.intro && <p class="text-lg md:text-xl text-[var(--foreground)] leading-relaxed font-medium max-w-[70ch] mb-12">{header.intro}</p>}
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
          {header.ctaPrimaryLabel && (
            <a href="#pricing" class="btn-primary px-6 md:px-9 py-4 md:py-5 inline-flex items-center gap-3">
              {header.ctaPrimaryLabel}
              <Icon name="tabler:arrow-right" class="w-3.5 h-3.5" />
            </a>
          )}
          {header.ctaSecondaryLabel && (
            <a href="#pricing" class="btn-outline-dark px-6 md:px-9 py-4 md:py-5">{header.ctaSecondaryLabel}</a>
          )}
        </div>
        {header.proofLine && (
          <p class="text-[11px] font-bold text-[var(--foreground)] uppercase tracking-widest mt-8">{header.proofLine}</p>
        )}
      </div>
    </header>
  )
}

<style>
  .hiw-header {
    --foreground: #404040;
    --card-foreground: #121212;
    --primary: #9d2235;
    --secondary: #855b00;
    --secondary-foreground: #ffffff;
    --border: #e3e0dc;
    font-family: 'Sora Variable', 'Sora', sans-serif;
  }
  .hiw-header .btn-primary {
    background-color: var(--primary);
    color: #fff;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 12px;
    border-radius: 0;
  }
  .hiw-header .btn-outline-dark {
    border: 2px solid var(--card-foreground);
    color: var(--card-foreground);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 12px;
    border-radius: 0;
  }
</style>
