---
/**
 * Resources intro band — breadcrumb, H1, intro copy, indexed counter, search.
 * Props = CMS `resourcesIntro` section document.
 */
import { Icon } from 'astro-icon/components';
import type { ResourcesIntroContent } from '@lib/sanity/types';

interface Props {
  intro: ResourcesIntroContent;
}

const { intro } = Astro.props;
---

<section class="intro">
  <div class="wrap">
    <nav class="crumbs">
      <span>{intro.breadcrumbRoot}</span>
      <Icon name="tabler:chevron-right" class="sep" />
      <span class="current">{intro.title}</span>
    </nav>
    <div class="row">
      <div class="lede">
        <h1>{intro.title}</h1>
        <p>{intro.introText}</p>
      </div>
      <div class="counter">
        <span class="pulse" aria-hidden="true"></span>
        <span class="counter-label">{intro.indexedLabel}</span>
      </div>
    </div>
    <div class="search">
      <Icon name="tabler:search" class="search-icon" />
      <input type="text" placeholder={intro.searchPlaceholder} />
    </div>
  </div>
</section>

<style>
  .intro { font-family: 'Sora Variable', 'Sora', sans-serif; background: #faf7f2; border-bottom: 1px solid var(--rx-border, #e3e0dc); padding: 64px 48px; }
  .wrap { max-width: 1280px; margin: 0 auto; }
  .crumbs { display: flex; align-items: center; gap: 8px; margin-bottom: 24px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2em; color: #404040; }
  .sep { width: 9px; height: 9px; opacity: 0.4; }
  .current { color: #9d2235; }
  .row { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; gap: 32px; margin-bottom: 40px; }
  .lede { max-width: 672px; }
  h1 { font-size: 48px; font-weight: 800; color: #121212; letter-spacing: -0.025em; margin: 0 0 20px; }
  .lede p { font-size: 18px; line-height: 1.625; font-weight: 500; color: #404040; margin: 0; max-width: 70ch; }
  .counter { display: flex; align-items: center; gap: 12px; }
  .pulse { position: relative; display: inline-flex; width: 8px; height: 8px; }
  .pulse::before { content: ''; position: absolute; inset: 0; border-radius: 9999px; background: #22c55e; opacity: 0.75; animation: rx-ping 1.5s cubic-bezier(0,0,0.2,1) infinite; }
  .pulse::after { content: ''; position: relative; display: inline-flex; border-radius: 9999px; width: 8px; height: 8px; background: #22c55e; }
  @keyframes rx-ping { 75%, 100% { transform: scale(2); opacity: 0; } }
  .counter-label { font-size: 11px; font-weight: 700; color: #121212; text-transform: uppercase; letter-spacing: 0.1em; }
  .search { position: relative; max-width: 768px; }
  .search-icon { position: absolute; left: 20px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; color: #555; }
  input { width: 100%; border: 1px solid #e3e0dc; padding: 20px 20px 20px 56px; font-family: inherit; font-size: 14px; font-weight: 500; outline: none; background: #fff; color: #121212; }
  input:focus { border-color: #121212; }
  input::placeholder { color: #9ca3af; }
  @media (max-width: 1024px) {
    .intro { padding: 48px 16px; }
    .row { flex-direction: column; align-items: flex-start; }
    h1 { font-size: 36px; }
  }
</style>
