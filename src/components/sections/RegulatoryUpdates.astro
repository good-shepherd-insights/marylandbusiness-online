---
/**
 * Regulatory & Policy Updates feed — jurisdiction filter buttons + update
 * cards. Filter buttons are static markup (client-side filtering per
 * TAGS.md: never indexed); card data = CMS props.
 */
import { Icon } from 'astro-icon/components';
import type { RegulatoryUpdatesContent } from '@lib/sanity/types';

interface Props {
  section: RegulatoryUpdatesContent;
}

const { section } = Astro.props;
---

<section class="reg-updates">
  <div class="wrap">
    <div class="head">
      <div>
        <span class="eyebrow">{section.eyebrow}</span>
        <h2>{section.heading}</h2>
      </div>
      <a class="archive" href={section.archiveUrl}>{section.archiveLabel}</a>
    </div>

    <div class="filters">
      {section.filterLabels.map((label, i) => (
        <button class:list={['filter', { active: i === 0 }]}>{label}</button>
      ))}
    </div>

    <div class="feed">
      {(section.updates ?? []).map((update) => (
        <article class="update">
          <div class="date">
            <span class="date-caption">{section.dateCaption}</span>
            <span class="date-value">{update.effectiveDateText}</span>
          </div>
          <div class="body">
            <div class="badges">
              <span class:list={['jurisdiction', update.jurisdictionKind]}>{update.jurisdictionLabel}</span>
              <span class="type-chip">{update.typeLabel}</span>
            </div>
            <h3>{update.title}</h3>
            <p>{update.description}</p>
            <a class="notice" href={update.url} target="_blank" rel="noopener noreferrer">
              {section.cardLinkLabel}
              <Icon name="tabler:arrow-up-right" class="notice-icon" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .reg-updates { font-family: 'Sora Variable', 'Sora', sans-serif; padding: 80px 48px; background: #fdfcfb; border-bottom: 1px solid #e3e0dc; }
  .wrap { max-width: 1280px; margin: 0 auto; }
  .head { display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; gap: 24px; margin-bottom: 40px; }
  @media (min-width: 768px) { .head { flex-direction: row; align-items: flex-end; } }
  .eyebrow { display: block; color: #9d2235; font-weight: 800; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 12px; }
  h2 { font-size: 30px; font-weight: 800; color: #121212; letter-spacing: -0.025em; margin: 0; }
  .archive { font-size: 10px; font-weight: 800; color: #9d2235; text-transform: uppercase; letter-spacing: 0.1em; border-bottom: 2px solid #9d2235; padding-bottom: 4px; text-decoration: none; }
  .archive:hover { opacity: 0.7; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
  .filter { font-family: inherit; border: 1px solid #e3e0dc; color: #121212; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 10px; background: #fff; border-radius: 0; padding: 10px 20px; cursor: pointer; }
  .filter:hover { border-color: #121212; background: #fafafa; }
  .filter.active { background: #121212; color: #fff; border-color: #121212; }
  .feed { background: #faf7f2; border: 1px solid #e3e0dc; }
  .update { border-bottom: 1px solid #e3e0dc; padding: 28px; display: flex; align-items: flex-start; gap: 24px; transition: background 0.2s ease; }
  .update:last-child { border-bottom: 0; }
  .update:hover { background: #fafafa; }
  .date { width: 96px; flex-shrink: 0; text-align: center; padding-top: 4px; }
  .date-caption { display: block; font-size: 9px; font-weight: 700; color: #555; text-transform: uppercase; letter-spacing: 0.1em; }
  .date-value { display: block; font-size: 14px; font-weight: 800; color: #121212; }
  .body { flex: 1; border-left: 1px solid #e3e0dc; padding-left: 24px; }
  .badges { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
  .jurisdiction { font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; padding: 4px 8px; }
  .jurisdiction.state { background: #9d2235; color: #fff; }
  .jurisdiction.county { background: #121212; color: #fff; }
  .jurisdiction.city { background: #eaaa00; color: #121212; }
  .type-chip { font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; padding: 4px 8px; border: 1px solid #e3e0dc; color: #121212; }
  h3 { font-size: 16px; font-weight: 800; color: #121212; text-transform: uppercase; letter-spacing: -0.025em; margin: 0 0 8px; }
  .body p { font-size: 14px; color: #555; line-height: 1.625; margin: 0 0 12px; }
  .notice { font-size: 10px; font-weight: 800; color: #121212; text-transform: uppercase; letter-spacing: 0.1em; text-decoration: none; }
  .notice:hover { color: #9d2235; }
  .notice-icon { width: 10px; height: 10px; margin-left: 4px; vertical-align: -1px; }
  @media (max-width: 768px) {
    .reg-updates { padding: 56px 16px; }
    .update { flex-direction: column; }
    .body { border-left: 0; padding-left: 0; }
  }
</style>
