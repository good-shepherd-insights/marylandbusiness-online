---
/**
 * Offer arms section — "What We Offer" band: a borderless-gap grid of offer
 * cards with per-card CTAs. Icon tint cycles primary/secondary/dark by
 * position (CSS) — never data. All content from Sanity `about.offerArms`.
 */
import { Icon } from 'astro-icon/components';
import type { OfferArmsContent, OfferArm } from '@lib/sanity/types';

interface Props {
  offerArms: OfferArmsContent;
}

const { eyebrow, heading, arms } = Astro.props.offerArms;
const validArms = (arms ?? []).filter((a) => a.title);
---

{
  validArms.length > 0 && (
    <section class="offers">
      <div class="offers-inner">
        <div class="offers-intro">
          {eyebrow && <span class="offers-eyebrow">{eyebrow}</span>}
          {heading && <h2>{heading}</h2>}
        </div>
        <div class="offers-grid">
          {validArms.map((arm: OfferArm) => (
            <div class="offer-card">
              <div class="flex items-center gap-3 mb-4">
                {arm.icon && (
                  <div class="offer-icon shrink-0">
                    <Icon name={arm.icon} />
                  </div>
                )}
                {arm.title && <h3>{arm.title}</h3>}
              </div>
              {arm.text && <p>{arm.text}</p>}
              {arm.ctaLabel && arm.ctaLink && (
                <a class="offer-cta" href={arm.ctaLink}>
                  <span>{arm.ctaLabel}</span>
                  <Icon name="tabler:arrow-right" />
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .offers {
    --offers-primary: #9d2235;
    --offers-secondary: #b48300;
    --offers-secondary-foreground: #ffffff;
    --offers-foreground: #121212;
    --offers-muted: #404040;
    --offers-border: #e3e0dc;
    --offers-background: #faf7f2;

    background: var(--offers-background);
    border-top: 1px solid var(--offers-border);
    border-bottom: 1px solid var(--offers-border);
    padding: 7rem 1rem;
  }

  .offers-inner {
    max-width: 80rem;
    margin: 0 auto;
  }

  .offers-intro {
    max-width: 48rem;
    margin-bottom: 4rem;
  }

  .offers-eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--offers-primary);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 1.5rem;
  }

  .offers-intro h2 {
    font-size: 2.5rem;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--offers-foreground);
    margin: 0;
  }

  .offers-grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--offers-border);
    border-left: 1px solid var(--offers-border);
  }

  .offer-card {
    display: flex;
    flex-direction: column;
    padding: 2.5rem;
    border-right: 1px solid var(--offers-border);
    border-bottom: 1px solid var(--offers-border);
  }

  .offer-icon {
    width: 2rem;
    height: 2rem;
    background: transparent;
    color: var(--offers-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .offer-card:nth-child(3n + 2) .offer-icon {
    color: var(--offers-secondary);
  }

  .offer-card:nth-child(3n) .offer-icon {
    color: #121212;
  }

  .offer-icon :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .offer-card h3 {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--offers-foreground);
    margin: 0;
  }

  .offer-card p {
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--offers-muted);
    margin: 0 0 2rem;
    flex: 1;
    max-width: 70ch;
  }

  .offer-cta {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.625rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--offers-foreground);
    text-decoration: none;
    border-bottom: 2px solid var(--offers-foreground);
    padding-bottom: 0.25rem;
  }

  .offer-cta :global(svg) {
    width: 0.5625rem;
    height: 0.5625rem;
  }

  @media (min-width: 768px) {
    .offers {
      padding: 7rem 3rem;
    }

    .offers-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
