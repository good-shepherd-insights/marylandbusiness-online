---
/**
 * Social feed section — dark community band: heading/description header with
 * live indicator (presentation only), borderless-gap grid of feed cards, and
 * a closing ghost CTA. All content comes from Sanity `home.socialFeed`; the
 * component renders nothing when the section is absent or empty and never
 * substitutes its own copy. Star rows and the pulsing dot are CSS, not CMS.
 */
import { Icon } from 'astro-icon/components';
import { sanityImageUrl } from '@lib/sanity/client';
import type { SocialFeedContent, SocialFeedItem } from '@lib/sanity/types';

interface Props {
  socialFeed: SocialFeedContent;
}

const { heading, liveLabel, description, items, ctaLabel, ctaLink } = Astro.props.socialFeed;

const validItems = (items ?? []).filter((item) => item.name);
---

{
  validItems.length > 0 && (
    <section class="social">
      <div class="social-inner">
        <div class="social-header">
          <div class="social-intro">
            {heading && <h2>{heading}</h2>}
            {description && <p>{description}</p>}
          </div>
          <div class="social-live">
            <span class="social-live-dot" />
            {liveLabel}
          </div>
        </div>
        <div class="social-grid">
          {validItems.map((item: SocialFeedItem) => (
            <div class="social-item">
              <div class="social-person">
                {item.avatar?.asset && (
                  <img
                    src={sanityImageUrl(item.avatar, { width: 80 })}
                    alt={item.name ?? ''}
                    loading="lazy"
                  />
                )}
                <div>
                  {item.name && <h4>{item.name}</h4>}
                  {item.location && <p>{item.location}</p>}
                </div>
              </div>
              <div class="social-stars" aria-hidden="true">
                {Array.from({ length: 5 }).map(() => <Icon name="tabler:star-filled" />)}
              </div>
              {item.quote && <p class="social-quote">{item.quote}</p>}
              <div class="social-footer">
                {item.activityLabel && (
                  <div class="social-activity">
                    {item.activityIcon && <Icon name={item.activityIcon} />}
                    <span>{item.activityLabel}</span>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
        {ctaLabel && ctaLink && (
          <div class="social-cta-row">
            <a class="social-cta" href={ctaLink}>{ctaLabel}</a>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .social {
    --social-accent: #ffb612;
    --social-secondary: #eaaa00;
    --social-border: rgb(255 255 255 / 10%);
    --social-card: rgb(255 255 5%);
    --social-muted: #9ca3af;

    background: #121212;
    color: #ffffff;
    padding: 8rem 1rem;
  }

  .social-inner {
    max-width: 80rem;
    margin: 0 auto;
  }

  .social-header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 5rem;
  }

  .social-intro {
    max-width: 42rem;
  }

  .social-intro h2 {
    font-size: 2.25rem;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #ffffff;
    margin: 0 0 1.5rem;
  }

  .social-intro p {
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 500;
    color: var(--social-muted);
    margin: 0;
  }

  .social-live {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--social-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .social-live-dot {
    position: relative;
    display: inline-flex;
    width: 0.75rem;
    height: 0.75rem;
  }

  .social-live-dot::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: var(--social-secondary);
    opacity: 0.75;
    animation: social-ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .social-live-dot::after {
    content: '';
    position: relative;
    display: inline-flex;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 9999px;
    background: var(--social-secondary);
  }

  @keyframes social-ping {
    0% {
      transform: scale(1);
      opacity: 0.75;
    }
    75%,
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .social-grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--social-border);
    border-left: 1px solid var(--social-border);
  }

  .social-item {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    background: rgb(255 255 255 / 5%);
    border-right: 1px solid var(--social-border);
    border-bottom: 1px solid var(--social-border);
    border-left: 4px solid var(--social-secondary);
  }

  .social-item :global(img) {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: cover;
    filter: grayscale(1);
    border: 1px solid rgb(255 255 255 / 20%);
  }

  .social-person {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .social-person h4 {
    font-size: 0.75rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .social-person p {
    font-size: 0.5625rem;
    font-weight: 700;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .social-stars {
    display: flex;
    gap: 0.125rem;
    color: var(--social-accent);
    margin-bottom: 1rem;
  }

  .social-stars :global(svg) {
    width: 0.625rem;
    height: 0.625rem;
  }

  .social-quote {
    font-size: 0.75rem;
    line-height: 1.625;
    color: #d1d5db;
    font-style: italic;
    margin: 0 0 2rem;
  }

  .social-footer {
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--social-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .social-activity {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.5625rem;
    font-weight: 700;
    color: var(--social-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .social-activity :global(svg) {
    width: 0.625rem;
    height: 0.625rem;
  }

  .social-cta-row {
    margin-top: 4rem;
    text-align: center;
  }

  .social-cta {
    display: inline-block;
    padding: 1rem 2rem;
    border: 1px solid rgb(255 255 255 / 20%);
    color: #ffffff;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .social {
      padding: 8rem 3rem;
    }

    .social-header {
      flex-direction: row;
      align-items: flex-end;
    }

    .social-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .social-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
