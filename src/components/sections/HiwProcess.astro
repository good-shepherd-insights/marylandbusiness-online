---
/**
 * Process timeline (design 12 §2): five steps, vertical connector line,
 * numbered dots (highlight step renders gold). Step + chip icons are code
 * literals indexed to the authored steps; hovers dropped (V-10).
 */
import { Icon } from 'astro-icon/components';
import type { SanityHiwProcess } from '@lib/sanity/types';

interface Props {
  process: SanityHiwProcess;
}

const { process } = Astro.props;
// Icon literals per authored step (fa file-pen/magnifying-glass/layer-group/
// tower-broadcast/chart-line → tabler), per census 12.
const stepIcons = ['tabler:file-pencil', 'tabler:search', 'tabler:stack-2', 'tabler:broadcast', 'tabler:chart-line'] as const;
// Owner-chip icons per authored step (fa user/building-shield/user/gears/user).
const ownerIcons = ['tabler:user', 'tabler:file-check', 'tabler:user', 'tabler:settings', 'tabler:user'] as const;
---

{
  process.heading && (
    <section id="process" class="hiw-process py-16 md:py-28 px-4 md:px-12 bg-[#FAF7F2]">
      <div class="max-w-5xl mx-auto">
        <div class="max-w-2xl mb-16 md:mb-20">
          {process.eyebrow && <span class="text-[var(--primary)] font-extrabold text-xs tracking-[0.2em] uppercase mb-6 block">{process.eyebrow}</span>}
          <h2 class="text-3xl md:text-4xl font-extrabold text-[var(--card-foreground)] mb-6 tracking-tight">{process.heading}</h2>
          {process.sub && <p class="text-lg text-[var(--foreground)] leading-relaxed font-medium">{process.sub}</p>}
        </div>

        <div class="relative">
          <div class="hidden md:block absolute left-8 top-4 bottom-4 w-[2px] bg-[var(--border)]"></div>
          <div class="flex flex-col gap-12 md:gap-16">
            {(process.steps ?? []).map((step, i) => (
              <div class="relative flex flex-col md:flex-row gap-6 md:gap-8">
                <div class="flex md:flex-col items-center md:items-center gap-4 md:gap-0 shrink-0">
                  <div
                    class:list={[
                      'relative z-10 w-14 h-14 md:w-16 md:h-16 flex items-center justify-center font-extrabold text-xl shrink-0',
                      step.highlight ? 'bg-[var(--secondary)] text-[var(--secondary-foreground)]' : 'bg-[var(--primary)] text-white',
                    ]}
                  >
                    {step.num}
                  </div>
                </div>
                <div class="flex-1 pb-2">
                  <div class="flex items-center gap-3 mb-3">
                    <Icon name={stepIcons[i] ?? 'tabler:file-pencil'} class="w-5 h-5 text-[var(--primary)] shrink-0" />
                    <h3 class="text-lg md:text-xl font-extrabold text-[var(--card-foreground)] tracking-tight">{step.title}</h3>
                  </div>
                  {step.description && <p class="text-base text-[var(--foreground)] leading-relaxed mb-4 max-w-prose">{step.description}</p>}
                  <div class="flex flex-wrap gap-4 text-[11px] font-extrabold uppercase tracking-widest">
                    {step.metaTime && (
                      <span class="px-3 py-1.5 border border-[var(--border)] text-[var(--card-foreground)] inline-flex items-center gap-2">
                        <Icon name="tabler:clock" class="w-3 h-3" />
                        {step.metaTime}
                      </span>
                    )}
                    {step.metaOwner && (
                      <span class="px-3 py-1.5 border border-[var(--border)] text-[var(--foreground)] inline-flex items-center gap-2">
                        <Icon name={ownerIcons[i] ?? 'tabler:user'} class="w-3 h-3" />
                        {step.metaOwner}
                      </span>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .hiw-process {
    --foreground: #404040;
    --card-foreground: #121212;
    --primary: #9d2235;
    --secondary: #855b00;
    --secondary-foreground: #ffffff;
    --border: #e3e0dc;
    font-family: 'Sora Variable', 'Sora', sans-serif;
  }
</style>
