---
/**
 * County/City quick-jump strip. Chips = live gate county hubs
 * (getGeoCountyHubs) — never CMS copy. Heading/view-all = CMS props.
 *
 * Fixes applied (critique 2026-09-27):
 *   T-4  h3 10px → 12px; chips 11px → 13px; view-all 10px → 13px
 *   P-7  chip min-height 44px (WCAG 2.5.5); view-all visible padding + min-height
 */
import { Icon } from 'astro-icon/components';
import { getGeoCountyHubs } from '@lib/directory/paths';
import type { CountyJumpContent } from '@lib/sanity/types';

interface Props {
  section: CountyJumpContent;
}

const { section } = Astro.props;
const hubs = await getGeoCountyHubs();
---

<section class="county-jump" aria-label={section.heading ?? 'Explore by County'}>
  <div class="wrap">
    <h3 class="county-jump-heading">{section.heading}</h3>
    <div class="chips" role="list">
      {hubs.map((hub) => (
        <a class="chip" href={`/${hub.path}`} role="listitem">{hub.label}</a>
      ))}
    </div>
    <div class="view-all-row">
      <a class="view-all" href={section.viewAllUrl}>
        {section.viewAllLabel}
        <Icon name="tabler:arrow-right" class="view-all-icon" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<style>
  .county-jump {
    font-family: 'Sora Variable', 'Sora', sans-serif;
    padding: 3.5rem 3rem;
    background: #f8f7f6;
    border-bottom: 1px solid #e3e0dc;
  }

  .wrap {
    max-width: 1280px;
    margin: 0 auto;
  }

  /* T-4 fix: 10px → 12px */
  .county-jump-heading {
    font-size: 0.75rem;      /* 12px — was 10px */
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #555555;
    margin: 0 0 1.25rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    background: #fff;
    border: 1px solid #e3e0dc;
    padding: 0 1.25rem;
    min-height: 44px;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #121212;
    text-decoration: none;
    white-space: nowrap;
  }

  .chip:hover {
    border-color: #9d2235;
    color: #9d2235;
    background: color-mix(in srgb, #9d2235 6%, #fff);
  }

  .chip:focus-visible {
    outline: 2px solid #9d2235;
    outline-offset: 2px;
  }

  .view-all-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.25rem;
  }

  /* T-4 + P-7 fix: 10px → 13px, visible tap target */
  .view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;    /* 13px — was 10px */
    font-weight: 700;
    color: #121212;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    padding: 0.5rem 0;
    min-height: 44px;        /* WCAG 2.5.5 */
  }

  .view-all:hover {
    color: #9d2235;
  }

  .view-all:focus-visible {
    outline: 2px solid #9d2235;
    outline-offset: 3px;
    border-radius: 2px;
  }

  .view-all-icon {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .county-jump {
      padding: 2.5rem 1rem;
    }

    .chips {
      gap: 0.5rem;
    }
  }
</style>
