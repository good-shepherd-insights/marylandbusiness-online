---
/**
 * FAQ accordion (design 12 §7): chevron rotates + answer expands when
 * open; first item opens by default. Toggle behavior is a tiny client
 * script — content is only question + answer.
 */
import { Icon } from 'astro-icon/components';
import type { SanityHiwFaq } from '@lib/sanity/types';

interface Props {
  faq: SanityHiwFaq;
}

const { faq } = Astro.props;
---

{
  faq.heading && (
    <section id="faq" class="hiw-faq py-16 md:py-28 px-4 md:px-12 bg-[#FDFCFB] border-t border-[var(--border)]">
      <div class="max-w-4xl mx-auto">
        <div class="mb-12 md:mb-16">
          {faq.eyebrow && <span class="text-[var(--primary)] font-extrabold text-xs tracking-[0.2em] uppercase mb-6 block">{faq.eyebrow}</span>}
          <h2 class="text-3xl md:text-4xl font-extrabold text-[var(--card-foreground)] mb-6 tracking-tight">{faq.heading}</h2>
        </div>

        <div class="border-t border-[var(--border)]">
          {(faq.items ?? []).map((item, i) => (
            <div class:list={['faq-item border-b border-[var(--border)]', i === 0 && 'open']}>
              <button
                type="button"
                class="faq-question w-full flex items-center justify-between py-6 text-left"
                aria-expanded={i === 0 ? "true" : "false"}
                aria-controls={`hiw-faq-answer-${i}`}
              >
                <h3 class="text-base font-extrabold text-[var(--card-foreground)] pr-8">{item.question}</h3>
                <Icon name="tabler:chevron-down" class="faq-chevron w-4 h-4 text-[var(--foreground)] shrink-0" aria-hidden="true" />
              </button>
              <div id={`hiw-faq-answer-${i}`} class="faq-answer" role="region" aria-label={item.question}>
                {item.answer && <p class="text-sm text-[var(--foreground)] leading-relaxed pb-6 pr-4 md:pr-10">{item.answer}</p>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLButtonElement>('.hiw-faq .faq-question').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const isOpen = item?.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(Boolean(isOpen)));
    });
  });
</script>

<style>
  .hiw-faq {
    --foreground: #555555;
    --card-foreground: #121212;
    --primary: #9d2235;
    --border: #e3e0dc;
    font-family: 'Sora Variable', 'Sora', sans-serif;
  }
  .faq-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }
  .faq-answer > * {
    overflow: hidden;
  }
  .faq-item.open .faq-answer {
    grid-template-rows: 1fr;
  }
  .faq-item.open :global(.faq-chevron) {
    transform: rotate(180deg);
  }
  :global(.faq-chevron) {
    transition: transform 0.25s ease;
  }
</style>
