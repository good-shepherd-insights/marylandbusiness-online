  }
  .btn-outline {
    border: 1px solid var(--border);
    color: var(--card-foreground);
    border-radius: 4px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 11px;
    background: white;
