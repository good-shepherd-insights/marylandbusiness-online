    border-color: var(--card-foreground);
  }
  .btn-outline.is-active {
    background: var(--card-foreground);
    color: #fff;
    border-color: var(--card-foreground);
  }
  /* Row content classes must match client-rendered rows too (renderRow
   * creates nodes without the scoped-CID attribute) — hence :global. */
  .hub-list[data-loading] {
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }
  .hub-list :global(.business-list-item) {
    border-bottom: 1px solid var(--border);
    cursor: pointer;
  }
  .hub-list :global(.business-list-item[hidden]) {
    display: none;
  }
  .hub-list :global(.business-list-item.row-flash) {
    background: #f3efe8;
  }
  .hub-list :global(.yelp-rating svg) { color: var(--accent); }
  .hub-list :global(.yelp-rating svg.star-empty) { color: var(--border); }
  .hub-list :global(.btn-primary) {
    background-color: var(--primary);
    color: var(--primary-foreground);
    border-radius: 4px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 11px;
  }
  .no-scrollbar {
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
