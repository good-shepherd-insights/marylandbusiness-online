---
/**
 * Vision pillars section — vision intro plus a grid of pillar cards.
 * Icon tint alternates primary/secondary/dark by position (CSS, TrustStrip
 * pattern) — never data. All content from Sanity `about.visionPillars`.
 */
import { Icon } from 'astro-icon/components';
import type { VisionPillarsContent, Pillar } from '@lib/sanity/types';

interface Props {
  visionPillars: VisionPillarsContent;
}

const { eyebrow, heading, description, pillars } = Astro.props.visionPillars;
const validPillars = (pillars ?? []).filter((p) => p.title);
---

{
  (heading || validPillars.length > 0) && (
    <section class="pillars">
      <div class="pillars-inner">
        <div class="pillars-intro">
          {eyebrow && <span class="pillars-eyebrow">{eyebrow}</span>}
          {heading && <h2>{heading}</h2>}
          {description && <p>{description}</p>}
        </div>
        <div class="pillars-grid">
          {validPillars.map((pillar: Pillar) => (
            <div class="pillar-card">
              <div class="flex items-center gap-3 mb-4">
                {pillar.icon && (
                  <div class="pillar-icon shrink-0">
                    <Icon name={pillar.icon} />
                  </div>
                )}
                {pillar.title && <h3>{pillar.title}</h3>}
              </div>
              {pillar.text && <p>{pillar.text}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .pillars {
    --pillars-primary: #9d2235;
    --pillars-secondary: #855b00;
    --pillars-foreground: #121212;
    --pillars-muted: #404040;
    --pillars-border: #e3e0dc;
    --pillars-background: #fdfcfb;
    --pillars-card: #faf7f2;
    --pillars-icon-box: #f8f7f6;

    background: var(--pillars-background);
    padding: 7rem 1rem;
  }

  .pillars-inner {
    max-width: 80rem;
    margin: 0 auto;
  }

  .pillars-intro {
    max-width: 48rem;
    margin-bottom: 4rem;
  }

  .pillars-eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--pillars-primary);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 1.5rem;
  }

  .pillars-intro h2 {
    font-size: 2.5rem;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--pillars-foreground);
    margin: 0 0 1.5rem;
  }

  .pillars-intro p {
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 500;
    color: var(--pillars-muted);
    margin: 0;
    max-width: 70ch;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .pillar-card {
    padding: 2rem;
    background: var(--pillars-card);
    border: 1px solid var(--pillars-border);
  }

  .pillar-icon {
    width: 2rem;
    height: 2rem;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pillars-primary);
  }

  .pillar-card:nth-child(3n + 2) .pillar-icon {
    color: var(--pillars-secondary);
  }

  .pillar-card:nth-child(3n) .pillar-icon {
    color: #121212;
  }

  .pillar-icon :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .pillar-card h3 {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--pillars-foreground);
    margin: 0;
  }

  .pillar-card p {
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--pillars-muted);
    margin: 0;
    max-width: 70ch;
  }

  @media (min-width: 768px) {
    .pillars {
      padding: 7rem 3rem;
    }

    .pillars-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .pillars-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
