---
/**
 * Alert signup band — dark call-to-action with email input. Props = CMS
 * `alertSignup` section document.
 */
import { Icon } from 'astro-icon/components';
import type { AlertSignupContent } from '@lib/sanity/types';

interface Props {
  section: AlertSignupContent;
}

const { section } = Astro.props;
---

<section class="alert-signup">
  <div class="wrap">
    <Icon name={`tabler:${section.icon}`} class="bell" />
    <h2>{section.heading}</h2>
    <p>{section.description}</p>
    <form class="form" method="post" action="#">
      <input type="email" placeholder={section.emailPlaceholder} />
      <button type="submit">{section.buttonLabel}</button>
    </form>
  </div>
</section>

<style>
  .alert-signup { font-family: 'Sora Variable', 'Sora', sans-serif; padding: 80px 48px; background: #121212; color: #fff; }
  .wrap { max-width: 768px; margin: 0 auto; text-align: center; }
  .bell { width: 24px; height: 24px; color: #eaaa00; margin-bottom: 24px; }
  h2 { font-size: 30px; font-weight: 800; letter-spacing: -0.025em; margin: 0 0 16px; }
  p { color: #9ca3af; font-weight: 500; margin: 0 0 40px; }
  .form { display: flex; flex-direction: column; gap: 8px; max-width: 512px; margin: 0 auto; }
  input { flex: 1; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.2); padding: 16px 20px; font-family: inherit; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; outline: none; color: #fff; border-radius: 0; }
  input:focus { border-color: #eaaa00; }
  input::placeholder { color: #9ca3af; }
  button { font-family: inherit; background: #9d2235; color: #fff; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; font-size: 12px; border: 0; border-radius: 0; padding: 16px 32px; white-space: nowrap; cursor: pointer; transition: filter 0.2s ease; }
  button:hover { filter: brightness(90%); }
  @media (max-width: 768px) {
    .alert-signup { padding: 56px 16px; }
  }
  @media (min-width: 640px) {
    .form { flex-direction: row; }
  }
</style>
