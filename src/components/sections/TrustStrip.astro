---
/**
 * Trust signal strip — centered row of CMS-driven icon + label signals.
 * All content comes from Sanity `home.trustStrip.signals`; the component
 * renders nothing when the section is absent or empty and never substitutes
 * its own copy. Icon tint alternates primary/secondary by position (CSS).
 */
import { Icon } from 'astro-icon/components';
import type { TrustStripContent } from '@lib/sanity/types';

interface Props {
  trustStrip: TrustStripContent;
}

const { signals } = Astro.props.trustStrip;
---

{
  signals && signals.length > 0 && (
    <div class="trust-strip">
      <div class="trust-strip-inner">
        {signals.map((signal, i) => {
          const defaultIcon = ['tabler:shield-check', 'tabler:award', 'tabler:building-bank', 'tabler:certificate'][i % 4];
          const iconName = signal.icon?.startsWith('tabler:') ? signal.icon : defaultIcon;
          return signal.label ? (
            <div class="trust-signal">
              <Icon name={iconName} aria-hidden="true" />
              <span>{signal.label}</span>
            </div>
          ) : null;
        })}
      </div>
    </div>
  )
}

<style>
  .trust-strip {
    --trust-primary: #9d2235;
    --trust-secondary: #eaaa00;
    --trust-foreground: #121212;
    --trust-border: #e3e0dc;
    --trust-background: #faf7f2;

    background: var(--trust-background);
    border-bottom: 1px solid var(--trust-border);
    padding: 2.5rem 1rem;
  }

  .trust-strip-inner {
    max-width: 80rem;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 4rem;
  }

  .trust-signal {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .trust-signal :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
  }

  .trust-signal:nth-child(odd) :global(svg) {
    color: var(--trust-primary);
  }

  .trust-signal:nth-child(even) :global(svg) {
    color: var(--trust-secondary);
  }

  .trust-signal span {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--trust-foreground);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (max-width: 767px) {
    .trust-strip-inner {
      gap: 2rem;
    }
  }
</style>