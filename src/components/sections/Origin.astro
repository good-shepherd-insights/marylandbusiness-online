---
/**
 * Origin section — "Why We Exist" band: image left, eyebrow/heading/
 * variable paragraphs right. All content from Sanity `about.origin`.
 */
import { sanityImageUrl } from '@lib/sanity/client';
import type { OriginContent } from '@lib/sanity/types';

interface Props {
  origin: OriginContent;
}

const { image, imageAlt, eyebrow, heading, paragraphs } = Astro.props.origin;
const validParagraphs = (paragraphs ?? []).filter(Boolean);
---

{
  (heading || validParagraphs.length > 0) && (
    <section class="origin">
      <div class="origin-inner">
        <div class="origin-grid">
          <div class="origin-media">
            {image?.asset && (
              <img
                src={sanityImageUrl(image, { width: 1200 })}
                srcset={`${sanityImageUrl(image, { width: 600 })} 1x, ${sanityImageUrl(image, { width: 1200 })} 2x`}
                alt={imageAlt ?? ''}
                loading="lazy"
              />
            )}
          </div>
          <div class="origin-content">
            {eyebrow && <span class="origin-eyebrow">{eyebrow}</span>}
            {heading && <h2>{heading}</h2>}
            {validParagraphs.map((text) => text && <p>{text}</p>)}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .origin {
    --origin-primary: #9d2235;
    --origin-foreground: #121212;
    --origin-muted: #404040;
    --origin-border: #e3e0dc;
    --origin-background: #faf7f2;

    background: var(--origin-background);
    padding: 7rem 1rem;
  }

  .origin-inner {
    max-width: 80rem;
    margin: 0 auto;
  }

  .origin-grid {
    display: grid;
    gap: 5rem;
    align-items: center;
  }

  .origin-media img {
    width: 100%;
    height: 35rem;
    object-fit: cover;
    border: 1px solid var(--origin-border);
  }

  .origin-eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--origin-primary);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 1.5rem;
  }

  .origin-content h2 {
    font-size: 2.5rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--origin-foreground);
    margin: 0 0 2rem;
  }

  .origin-content p {
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 500;
    color: var(--origin-muted);
    margin: 0 0 1.5rem;
    max-width: 70ch;
  }

  @media (min-width: 768px) {
    .origin {
      padding: 7rem 3rem;
    }
  }

  @media (min-width: 1024px) {
    .origin-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
