---
/**
 * Partnerships section — intro + CTA left, partner card grid right.
 * Icon tint cycles primary/secondary/dark by position (CSS) — never data.
 * All content from Sanity `about.partnerships`.
 */
import { Icon } from 'astro-icon/components';
import { sanityImageUrl } from '@lib/sanity/client';
import type { PartnershipsContent, Partner } from '@lib/sanity/types';

interface Props {
  partnerships: PartnershipsContent;
}

const { eyebrow, heading, description, ctaLabel, ctaLink, partners } = Astro.props.partnerships;
const validPartners = (partners ?? []).filter((p) => p?.title);
---

{
  (heading || validPartners.length > 0) && (
    <section class="partners">
      <div class="partners-inner">
        <div class="partners-grid">
          <div class="partners-intro">
            {eyebrow && <span class="partners-eyebrow">{eyebrow}</span>}
            {heading && <h2>{heading}</h2>}
            {description && <p>{description}</p>}
            {ctaLabel && ctaLink && (
              <a class="partners-cta" href={ctaLink}>
                <span>{ctaLabel}</span>
                <Icon name="tabler:arrow-right" />
              </a>
            )}
          </div>
          <div class="partners-cards">
            {validPartners.map((partner: Partner, i: number) => {
              const defaultIcon = ['tabler:briefcase', 'tabler:certificate', 'tabler:building', 'tabler:users'][i % 4];
              const iconName = partner.icon?.startsWith('tabler:') ? partner.icon : defaultIcon;
              return (
                <div class:list={['partner-card', { 'has-photo': !!partner.image }]}>
                  {partner.image ? (
                    <>
                      <img
                        class="partner-photo"
                        src={sanityImageUrl(partner.image, { width: 800, quality: 70 })}
                        alt={partner.imageAlt ?? partner.title ?? ''}
                        loading="lazy"
                        decoding="async"
                      />
                      <div class="partner-scrim" aria-hidden="true" />
                      <div class="partner-overlay">
                        {partner.title && <h3>{partner.title}</h3>}
                        {partner.text && <p>{partner.text}</p>}
                      </div>
                    </>
                  ) : (
                    <>
                      <div class="flex items-center gap-3 mb-3">
                        <div class="partner-icon shrink-0">
                          <Icon name={iconName} aria-hidden="true" />
                        </div>
                        {partner.title && <h3>{partner.title}</h3>}
                      </div>
                      {partner.text && <p>{partner.text}</p>}
                    </>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .partners {
    --partners-primary: #9d2235;
    --partners-secondary: #855b00;
    --partners-foreground: #121212;
    --partners-muted: #404040;
    --partners-border: #e3e0dc;
    --partners-background: #fdfcfb;
    --partners-card: #faf7f2;

    background: var(--partners-background);
    padding: 7rem 1rem;
  }

  .partners-inner {
    max-width: 80rem;
    margin: 0 auto;
  }

  .partners-grid {
    display: grid;
    gap: 4rem;
    align-items: start;
  }

  .partners-eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--partners-primary);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 1.5rem;
  }

  .partners-intro h2 {
    font-size: 2.25rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--partners-foreground);
    margin: 0 0 1.5rem;
  }

  .partners-intro > p {
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 500;
    color: var(--partners-muted);
    margin: 0 0 2.5rem;
    max-width: 70ch;
  }

  .partners-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem 2rem;
    background: var(--partners-primary);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
  }

  .partners-cta :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  .partners-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--partners-border);
    border-left: 1px solid var(--partners-border);
  }

  .partner-card {
    padding: 2rem;
    background: var(--partners-card);
    border-right: 1px solid var(--partners-border);
    border-bottom: 1px solid var(--partners-border);
  }

  /* Variation 4D: optional full-bleed photo background with dark scrim */
  .partner-card.has-photo {
    position: relative;
    padding: 0;
    overflow: hidden;
    min-height: 220px;
    display: flex;
    align-items: flex-end;
  }

  .partner-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .partner-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(12, 8, 10, 0.92) 0%, rgba(12, 8, 10, 0.62) 55%, rgba(12, 8, 10, 0.28) 100%);
  }

  .partner-overlay {
    position: relative;
    padding: 1.25rem;
    color: #ffffff;
  }

  .partner-card.has-photo .partner-overlay h3 {
    color: #ffffff;
    font-size: 0.95rem;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }

  .partner-card.has-photo .partner-overlay p {
    color: #e8e2d8;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }

  .partner-icon {
    color: var(--partners-primary);
  }

  .partner-card:nth-child(3n + 2) .partner-icon {
    color: var(--partners-secondary);
  }

  .partner-card:nth-child(3n) .partner-icon {
    color: #121212;
  }

  .partner-icon :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .partner-card h3 {
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--partners-foreground);
    margin: 0;
  }

  .partner-card p {
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--partners-muted);
    margin: 0;
    max-width: 70ch;
  }

  @media (min-width: 768px) {
    .partners {
      padding: 7rem 3rem;
    }

    .partners-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .partners-grid {
      grid-template-columns: repeat(5, 1fr);
    }

    .partners-intro {
      grid-column: span 2;
    }

    .partners-cards {
      grid-column: span 3;
    }
  }
</style>
