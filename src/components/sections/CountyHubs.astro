---
/**
 * County hubs — full-bleed photo cards for all 24 Maryland jurisdictions.
 * Each card shows its county photo (CMS-curated, hotspot-aware) under a
 * gradient overlay, with a business-count pill, county name, and explore
 * link. Cards without a photo fall back to a branded gradient with a
 * watermark pin so the grid stays visually intentional.
 */
import { Icon } from 'astro-icon/components';
import { sanityImageUrl } from '@lib/sanity/client';
import type { CountyHubsContent, SanityImage } from '@lib/sanity/types';

export interface HubCard {
  name: string;
  businesses?: string;
  image?: SanityImage;
  imageAlt?: string;
  link?: string;
}

interface Props {
  countyHubs: CountyHubsContent;
  hubs: HubCard[];
}

const { countyHubs, hubs } = Astro.props;
const { heading, description, ctaLabel, ctaLink } = countyHubs;
const cards = (hubs ?? []).filter((hub) => hub?.name);

/**
 * Desktop shows the first two rows (8 cards); the rest are hidden via CSS.
 * On mobile the grid becomes a 2-row swipe carousel holding all counties.
 */
const DESKTOP_VISIBLE = 8;

/** A card photo only renders when the CMS image has an asset. */
const hasImage = (hub: HubCard) => Boolean(hub.image?.asset?._ref);
---

{
  cards.length > 0 && (
    <section class="county-hubs" aria-label={heading ?? 'Explore Maryland by County'}>
      <div class="county-hubs-inner">
        <!-- Section Header -->
        <div class="county-hubs-header">
          <div class="county-hubs-intro">
            {heading && <h2>{heading}</h2>}
            {description && <p class="county-hubs-lead">{description}</p>}
          </div>
          {ctaLabel && ctaLink && (
            <a class="county-hubs-cta" href={ctaLink}>
              <span>{ctaLabel}</span>
              <Icon name="tabler:map" aria-hidden="true" />
            </a>
          )}
        </div>

        <!-- Full-Bleed Photo Grid / Mobile 2-row carousel -->
        <div class="county-hubs-grid" role="region" aria-label="Maryland county hubs">
          {cards.map((hub: HubCard, i: number) => {
            const CardTag = hub.link ? 'a' : 'div';
            const showImage = hasImage(hub);
            return (
              <CardTag
                class:list={[
                  'hub-card',
                  { 'hub-card--noimg': !showImage, 'hub-card--beyond': i >= DESKTOP_VISIBLE },
                ]}
                href={hub.link ?? undefined}
              >
                {showImage && hub.image && (
                  <img
                    class="hub-card-img"
                    src={sanityImageUrl(hub.image, { width: 800, quality: 70 })}
                    srcset={`${sanityImageUrl(hub.image, { width: 400, quality: 70 })} 1x, ${sanityImageUrl(hub.image, { width: 800, quality: 70 })} 2x`}
                    alt={hub.imageAlt ?? ''}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="hub-card-scrim" aria-hidden="true" />
                {!showImage && (
                  <Icon name="tabler:map-pin" class="hub-card-watermark" aria-hidden="true" />
                )}
                <div class="hub-card-top">
                  {hub.businesses && <span class="hub-card-pill">{hub.businesses}</span>}
                </div>
                <div class="hub-card-bottom">
                  <h3 class="hub-card-name">{hub.name}</h3>
                  <span class="hub-card-go">
                    Explore hub
                    <Icon name="tabler:arrow-right" aria-hidden="true" />
                  </span>
                </div>
              </CardTag>
            );
          })}
        </div>
      </div>
    </section>
  )
}

<style>
  .county-hubs {
    --hubs-primary: #9d2235;
    --hubs-foreground: #121212;
    --hubs-muted: #555555;
    --hubs-border: #e3e0dc;
    --hubs-background: #faf7f2;
    --hubs-fallback: linear-gradient(135deg, #a12638 0%, #57101d 100%);

    background: var(--hubs-background);
    border-top: 1px solid var(--hubs-border);
    border-bottom: 1px solid var(--hubs-border);
    padding: 6rem 1.5rem;
    font-family: 'Sora Variable', 'Sora', sans-serif;
  }

  .county-hubs-inner {
    max-width: 80rem;
    margin: 0 auto;
  }

  /* Section Header */
  .county-hubs-header {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 768px) {
    .county-hubs-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .county-hubs-intro {
    max-width: 46rem;
  }

  .county-hubs-intro h2 {
    font-size: clamp(2.25rem, 4vw, 3rem);
    line-height: 1.12;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--hubs-foreground);
    margin: 0 0 1rem;
  }

  .county-hubs-lead {
    font-size: 1.125rem;
    line-height: 1.7;
    font-weight: 400;
    color: var(--hubs-muted);
    margin: 0;
    max-width: 65ch;
  }

  .county-hubs-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--hubs-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    min-height: 48px;
    padding: 0.5rem 0;
  }

  .county-hubs-cta:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .county-hubs-cta :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .county-hubs-cta:focus-visible {
    outline: 2px solid var(--hubs-primary);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* Grid on desktop / 2-row swipe carousel on mobile */
  .county-hubs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 599px) {
    .county-hubs-grid {
      grid-template-columns: none;
      grid-template-rows: repeat(2, minmax(0, auto));
      grid-auto-flow: column;
      grid-auto-columns: min(74vw, 300px);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      margin-inline: -1.5rem;
      padding-inline: 1.5rem;
      padding-bottom: 0.25rem;
    }

    .county-hubs-grid::-webkit-scrollbar {
      display: none;
    }

    .county-hubs-grid .hub-card {
      scroll-snap-align: start;
      min-height: 220px;
    }
  }

  @media (min-width: 600px) {
    .county-hubs-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Desktop stays compact: only the first two rows are viewable */
    .county-hubs-grid .hub-card--beyond {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .county-hubs-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  @media (min-width: 1200px) {
    .county-hubs-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Full-Bleed Photo Card */
  .hub-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 240px;
    border-radius: 12px;
    overflow: hidden;
    isolation: isolate;
    text-decoration: none;
    color: #fff;
    padding: 1.25rem;
  }

  @media (min-width: 900px) {
    .hub-card {
      min-height: 300px;
    }
  }

  .hub-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.6s ease;
  }

  .hub-card:hover .hub-card-img {
    transform: scale(1.06);
  }

  .hub-card-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(8, 10, 8, 0.24) 0%,
      rgba(8, 10, 8, 0) 38%,
      rgba(8, 10, 8, 0.82) 100%
    );
  }

  /* Branded fallback when a county has no photo yet */
  .hub-card--noimg {
    background: var(--hubs-fallback);
  }

  .hub-card--noimg .hub-card-scrim {
    background: linear-gradient(
      180deg,
      rgba(8, 10, 8, 0) 40%,
      rgba(8, 10, 8, 0.45) 100%
    );
  }

  .hub-card-watermark {
    position: absolute;
    right: -1.75rem;
    bottom: -1.75rem;
    width: 9rem;
    height: 9rem;
    color: rgba(255, 255, 255, 0.14);
    z-index: -1;
  }

  .hub-card:focus-visible {
    outline: 2px solid var(--hubs-primary);
    outline-offset: 3px;
  }

  /* Card Content */
  .hub-card-top {
    display: flex;
    justify-content: flex-start;
    min-height: 1.75rem;
  }

  .hub-card-pill {
    display: inline-block;
    background: rgba(255, 255, 255, 0.94);
    color: var(--hubs-foreground);
    font-size: 0.6875rem; /* 11px */
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
  }

  .hub-card-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hub-card-name {
    font-size: 1.375rem; /* 22px */
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: #fff;
    margin: 0;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.35);
  }

  .hub-card-go {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem; /* 13px */
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    opacity: 0.92;
  }

  .hub-card-go :global(svg) {
    width: 1rem;
    height: 1rem;
    transition: transform 0.2s ease;
  }

  .hub-card:hover .hub-card-go :global(svg) {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hub-card-img,
    .hub-card-go :global(svg) {
      transition: none;
    }
  }

  @media (min-width: 1024px) {
    .county-hubs {
      padding: 7rem 2rem;
    }
  }
</style>
