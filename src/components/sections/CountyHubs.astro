---
/**
 * County hubs section — header row (heading + description left, CTA right)
 * above a borderless-gap grid of county cards. All content comes from Sanity
 * `home.countyHubs`; the component renders nothing when the section is absent
 * or has no hubs and never substitutes its own copy. Card hover tint and the
 * CTA arrow are presentation (CSS / fixed icon), not CMS data.
 *
 * Fixes applied (critique 2026-09-27):
 *   T-1  county-stat 11px → 13px; dropped uppercase+wide tracking
 *   D-1  restored .county-icon with tabler:map-pin; deleted dead CSS
 *   P-1  --hubs-muted confirmed at #555555 (6.98:1 on background)
 *   P-6  mobile card padding reduced + word-break guard for long county names
 */
import { Icon } from 'astro-icon/components';
import type { CountyHubsContent, CountyHub } from '@lib/sanity/types';

interface Props {
  countyHubs: CountyHubsContent;
}

const { heading, description, ctaLabel, ctaLink, hubs } = Astro.props.countyHubs;

const validHubs = (hubs ?? []).filter((hub) => hub.name);
---

{
  validHubs.length > 0 && (
    <section class="county-hubs" aria-label={heading ?? 'Explore Maryland by County'}>
      <div class="county-hubs-inner">
        <div class="county-hubs-header">
          <div class="county-hubs-intro">
            {heading && <h2>{heading}</h2>}
            {description && <p>{description}</p>}
          </div>
          {ctaLabel && ctaLink && (
            <a class="county-hubs-cta" href={ctaLink}>
              <span>{ctaLabel}</span>
              <Icon name="tabler:arrow-right" aria-hidden="true" />
            </a>
          )}
        </div>
        <div class="county-hubs-grid">
          {validHubs.map((hub: CountyHub) =>
            hub.link ? (
              <a class="county-card" href={hub.link}>
                <div class="county-card-header">
                  <Icon name="tabler:map-pin" class="county-icon-inline" aria-hidden="true" />
                  <h3>{hub.name}</h3>
                </div>
                {hub.businesses && <span class="county-stat">{hub.businesses}</span>}
              </a>
            ) : (
              <div class="county-card">
                <div class="county-card-header">
                  <Icon name="tabler:map-pin" class="county-icon-inline" aria-hidden="true" />
                  <h3>{hub.name}</h3>
                </div>
                {hub.businesses && <span class="county-stat">{hub.businesses}</span>}
              </div>
            ),
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .county-hubs {
    --hubs-primary: #9d2235;
    --hubs-foreground: #121212;
    --hubs-muted: #555555;        /* 6.98:1 on #faf7f2 — passes WCAG AA */
    --hubs-border: #e3e0dc;
    --hubs-background: #faf7f2;
    --hubs-icon-box: #f0ece4;
    --hubs-hover-background: #f0ece4;

    background: var(--hubs-background);
    border-top: 1px solid var(--hubs-border);
    border-bottom: 1px solid var(--hubs-border);
    padding: 5rem 1rem;
  }

  .county-hubs-inner {
    max-width: 80rem;
    margin: 0 auto;
  }

  .county-hubs-header {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 768px) {
    .county-hubs-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .county-hubs-intro {
    max-width: 42rem;
  }

  .county-hubs-intro h2 {
    font-size: 2.25rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--hubs-foreground);
    margin: 0 0 1rem;
  }

  .county-hubs-intro p {
    font-size: 1.0625rem;   /* 17px — readable body copy */
    line-height: 1.7;
    font-weight: 400;
    color: var(--hubs-muted);
    margin: 0;
    max-width: 70ch;
  }

  .county-hubs-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;   /* 13px — labeled link, not body copy */
    font-weight: 700;
    color: var(--hubs-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    padding: 0.5rem 0;      /* vertical tap area */
    min-height: 44px;
    align-self: center;
  }

  .county-hubs-cta :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .county-hubs-cta:focus-visible {
    outline: 2px solid var(--hubs-primary);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Grid: 2 cols mobile → 3 at md → 6 at lg */
  .county-hubs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .county-card {
    padding: 1.5rem 1rem;
    text-align: center;
    border: 1px solid var(--hubs-border);
    border-radius: 0;
    margin: -0.5px;
    text-decoration: none;
    color: inherit;
    word-break: break-word;
  }

  .county-card:hover {
    border-color: var(--hubs-primary);
    background: var(--hubs-hover-background);
  }

  .county-card:focus-visible {
    outline: 2px solid var(--hubs-primary);
    outline-offset: -2px;
    z-index: 1;
    position: relative;
  }

  .county-card-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    margin-bottom: 0.375rem;
  }

  .county-icon-inline {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--hubs-primary);
    flex-shrink: 0;
  }

  .county-card h3 {
    font-size: 0.8125rem;    /* 13px — heading, not body copy */
    font-weight: 700;
    color: var(--hubs-foreground);
    letter-spacing: -0.01em; /* tighter tracking — readable at this size */
    margin: 0;
    line-height: 1.3;
  }

  /* T-1 fix: 13px, no uppercase, reduced tracking */
  .county-stat {
    display: inline-block;
    font-size: 0.8125rem;    /* 13px — was 11px */
    font-weight: 500;
    color: var(--hubs-muted);
    letter-spacing: 0;
  }

  @media (min-width: 480px) {
    .county-card {
      padding: 1.75rem 1.25rem;
    }
  }

  @media (min-width: 768px) {
    .county-hubs {
      padding: 6rem 3rem;
    }

    .county-hubs-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .county-card {
      padding: 2rem 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .county-hubs-grid {
      grid-template-columns: repeat(6, 1fr);
    }

    .county-card {
      padding: 2rem 1rem;
    }
  }
</style>