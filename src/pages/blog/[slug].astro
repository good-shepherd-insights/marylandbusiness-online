---
import { PortableText } from "astro-portabletext";
import Article from "@layouts/Article.astro";
import { getBlogPost } from "@lib/sanity/queries";
import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';
const perspectiveCookie = Astro.cookies.get(perspectiveCookieName)?.value;

const { slug } = Astro.params;
const entry = slug ? await getBlogPost(slug, perspectiveCookie) : undefined;

if (!entry) {
  return Astro.redirect("/404");
}
---

<Article frontmatter={entry.data} slug={slug}>
  <PortableText value={entry.body as any ?? []} />
</Article>