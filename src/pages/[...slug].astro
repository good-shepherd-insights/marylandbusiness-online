---
import { getEntry, render } from "astro:content";
import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';
const perspectiveCookie = Astro.cookies.get(perspectiveCookieName)?.value;
import { PortableText } from "astro-portabletext";
import Listing from "@layouts/Listing.astro";
import Landing from "@layouts/Landing.astro";
import { getListing, getHomePage, getAboutPage, getSiteSettings, getDirectoryPage } from "@lib/sanity/queries";
import { getCountyOptions, getGlobalHubView } from "@lib/directory/paths";
import BaseLayout from "@layouts/BaseLayout.astro";
import HubHeader from "@components/sections/HubHeader.astro";
import HubDiscovery from "@components/sections/HubDiscovery.astro";
import HubBasic from "@components/sections/HubBasic.astro";
import "@fontsource-variable/sora";
import Hero from "@components/sections/Hero.astro";
import Navbar from "@components/app/Navbar.astro";
import Footer from "@components/app/Footer.astro";
import CountyHubs from "@components/sections/CountyHubs.astro";
import FeaturedBusinesses from "@components/sections/FeaturedBusinesses.astro";
import Editorial from "@components/sections/Editorial.astro";
import SocialFeed from "@components/sections/SocialFeed.astro";
import HomeNews from "@components/sections/HomeNews.astro";
import HomePathways from "@components/sections/HomePathways.astro";
import HomeCategoryIndex from "@components/sections/HomeCategoryIndex.astro";
import HomeMethodology from "@components/sections/HomeMethodology.astro";
import HomeFaq from "@components/sections/HomeFaq.astro";
import { getCategoryTree } from "@lib/sanity/queries";
import AboutHeader from "@components/sections/AboutHeader.astro";
import StatStrip from "@components/sections/StatStrip.astro";
import Origin from "@components/sections/Origin.astro";
import MissionBand from "@components/sections/MissionBand.astro";
import VisionPillars from "@components/sections/VisionPillars.astro";
import OfferArms from "@components/sections/OfferArms.astro";
import Partnerships from "@components/sections/Partnerships.astro";
import ClosingCta from "@components/sections/ClosingCta.astro";

// Fetch the Sanity listing for this slug, or fall back to a local MDX page
// (landing copy with embedded directory components).
const { slug } = Astro.params;
const listing = slug ? await getListing(slug, perspectiveCookie) : undefined;
const pageEntry = await getEntry("pages", slug ?? "index");
const home = !slug ? await getHomePage(perspectiveCookie) : undefined;
const categoryTree = !slug ? await getCategoryTree(perspectiveCookie) : [];
const about = slug === "about" ? await getAboutPage(perspectiveCookie) : undefined;
// Global navbar: every page (home already renders it in the trust-bar slot).
const settings = await getSiteSettings(perspectiveCookie);
const MdxContent = pageEntry ? (await render(pageEntry)).Content : null;

// `/?af=…` is the directory-hub landing for chip-carrying redirects
// (bare categories, zero-listing entities — HUB-DIRECTORY-RESEARCH.md):
// the hub UI renders here so the chips actually activate. Plain `/` stays
// the marketing landing.
const afParam = !slug ? Astro.url.searchParams.get("af") : null;
const globalHub = !slug && afParam ? await getGlobalHubView() : undefined;
const hubDirectoryPage = globalHub ? await getDirectoryPage(perspectiveCookie) : undefined;
const hubCounties = globalHub ? await getCountyOptions() : undefined;

if (!listing && !MdxContent && !about && !globalHub) {
  // No dedicated /404 route exists; return the status directly so crawlers
  // and previews see 404 instead of a redirect to a missing page.
  return new Response("Not found", { status: 404 });
}

if (!listing && !MdxContent && !about) {
  // No dedicated /404 route exists; return the status directly so crawlers
  // and previews see 404 instead of a redirect to a missing page.
  return new Response("Not found", { status: 404 });
}
---

{
  slug === "about" ? (
    about?.header ||
    about?.statStrip ||
    about?.origin ||
    about?.missionBand ||
    about?.visionPillars ||
    about?.offerArms ||
    about?.partnerships ||
    about?.closingCta ? (
      <BaseLayout>
        {settings && <Navbar settings={settings} />}
        {about.header && <AboutHeader header={about.header} />}
        {about.statStrip && <StatStrip statStrip={about.statStrip} />}
        {about.origin && <Origin origin={about.origin} />}
        {about.missionBand && <MissionBand missionBand={about.missionBand} />}
        {about.visionPillars && <VisionPillars visionPillars={about.visionPillars} />}
        {about.offerArms && <OfferArms offerArms={about.offerArms} />}
        {about.partnerships && <Partnerships partnerships={about.partnerships} />}
        {about.closingCta && <ClosingCta closingCta={about.closingCta} />}
        {settings && <Footer settings={settings} />}
      </BaseLayout>
    ) : null
  ) : !slug && globalHub ? (
    // Directory hub landing (af chips from tag/business redirects).
    hubDirectoryPage?.hubHeader && hubDirectoryPage.hubDiscovery ? (
      <BaseLayout title={globalHub.hub.label} slug={slug}>
        <div
          class="hub-page min-h-dvh bg-[#FAF7F2] flex flex-col overflow-hidden"
          style="font-family: 'Sora Variable', 'Sora', sans-serif;"
        >
          {settings && <Navbar settings={settings} />}
          <HubHeader header={hubDirectoryPage.hubHeader!} label={globalHub.hub.label} />
          <HubDiscovery discovery={hubDirectoryPage.hubDiscovery!} hub={globalHub.hub} filters={globalHub.filters} counties={hubCounties} />
          {settings && <Footer settings={settings} />}
        </div>
      </BaseLayout>
    ) : (
      <BaseLayout title={globalHub.hub.label} slug={slug}>
        <HubBasic label={globalHub.hub.label} description={null} hub={globalHub.hub} />
        {settings && <Footer settings={settings} />}
      </BaseLayout>
    )
  ) : !slug ? (
    // Home: hero + navbar (trust bar replaced), no Landing shell (sidebar/nav/announcement bar).
    home?.hero || home?.trustStrip || home?.countyHubs || home?.featuredBusinesses || home?.editorial || home?.socialFeed || home?.homeNews ? (
      <BaseLayout>
        {home.hero && <Hero hero={home.hero} />}
        {settings && <Navbar settings={settings} />}
        {home.countyHubs && <CountyHubs countyHubs={home.countyHubs} />}
        {home.featuredBusinesses && <FeaturedBusinesses featuredBusinesses={home.featuredBusinesses} />}
        {home.editorial && <Editorial editorial={home.editorial} />}
        {home.socialFeed && <SocialFeed socialFeed={home.socialFeed} />}
        {home.homeNews && <HomeNews news={home.homeNews} />}
        {home.homePathways && <HomePathways pathways={home.homePathways} />}
        {home.homeCategoryIndex && <HomeCategoryIndex section={home.homeCategoryIndex} groups={categoryTree} />}
        {home.homeMethodology && <HomeMethodology methodology={home.homeMethodology} />}
        {home.homeFaq && <HomeFaq faq={home.homeFaq} />}
        {settings && <Footer settings={settings} />}
      </BaseLayout>
    ) : null
  ) : listing ? (
    <Listing frontmatter={listing} slug={slug}>
      <PortableText value={listing.about ?? []} />
    </Listing>
  ) : MdxContent ? (
    <Landing>
      {settings && <Navbar settings={settings} />}
      <MdxContent />
      {settings && <Footer settings={settings} />}
    </Landing>
  ) : null
}