---
import { getEntry, render } from "astro:content";
import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';
const perspectiveCookie = Astro.cookies.get(perspectiveCookieName)?.value;
import { PortableText } from "astro-portabletext";
import Listing from "@layouts/Listing.astro";
import Landing from "@layouts/Landing.astro";
import { getListing, getAboutPage, getSiteSettings } from "@lib/sanity/queries";
import BaseLayout from "@layouts/BaseLayout.astro";
import "@fontsource-variable/sora";
import Navbar from "@components/app/Navbar.astro";
import Footer from "@components/app/Footer.astro";
import AboutHeader from "@components/sections/AboutHeader.astro";
import StatStrip from "@components/sections/StatStrip.astro";
import Origin from "@components/sections/Origin.astro";
import MissionBand from "@components/sections/MissionBand.astro";
import VisionPillars from "@components/sections/VisionPillars.astro";
import OfferArms from "@components/sections/OfferArms.astro";
import Partnerships from "@components/sections/Partnerships.astro";
import ClosingCta from "@components/sections/ClosingCta.astro";

// Fetch the Sanity listing for this slug, or fall back to a local MDX page
// (landing copy with embedded directory components).
const { slug } = Astro.params;
const listing = slug ? await getListing(slug, perspectiveCookie) : undefined;
const pageEntry = await getEntry("pages", slug ?? "index");
const about = slug === "about" ? await getAboutPage(perspectiveCookie) : undefined;
// Global navbar: every page served by this catch-all.
const settings = await getSiteSettings(perspectiveCookie);
const MdxContent = pageEntry ? (await render(pageEntry)).Content : null;

if (!listing && !MdxContent && !about) {
  // No dedicated /404 route exists; return the status directly so crawlers
  // and previews see 404 instead of a redirect to a missing page.
  return new Response("Not found", { status: 404 });
}
---

{
  slug === "about" ? (
    about?.header ||
    about?.statStrip ||
    about?.origin ||
    about?.missionBand ||
    about?.visionPillars ||
    about?.offerArms ||
    about?.partnerships ||
    about?.closingCta ? (
      <BaseLayout>
        {settings && <Navbar settings={settings} />}
        {about.header && <AboutHeader header={about.header} />}
        {about.statStrip && <StatStrip statStrip={about.statStrip} />}
        {about.origin && <Origin origin={about.origin} />}
        {about.missionBand && <MissionBand missionBand={about.missionBand} />}
        {about.visionPillars && <VisionPillars visionPillars={about.visionPillars} />}
        {about.offerArms && <OfferArms offerArms={about.offerArms} />}
        {about.partnerships && <Partnerships partnerships={about.partnerships} />}
        {about.closingCta && <ClosingCta closingCta={about.closingCta} />}
        {settings && <Footer settings={settings} />}
      </BaseLayout>
    ) : null
  ) : listing ? (
    <Listing frontmatter={listing} slug={slug}>
      <PortableText value={listing.about ?? []} />
    </Listing>
  ) : MdxContent ? (
    <Landing>
      {settings && <Navbar settings={settings} />}
      <MdxContent />
      {settings && <Footer settings={settings} />}
    </Landing>
  ) : null
}
